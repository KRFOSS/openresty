#!/usr/bin/env bash

root=`perl -MCwd -e'print Cwd::abs_path(shift)' $(dirname -- "$0")/..`

"$root/util/mirror-tarballs-core" "$@" || exit 1

. "$root/util/ver"
name=openresty-$version
ngx_lua_ver=0.10.32rc3
ngx_lua_dir="$root/$name/bundle/ngx_lua-$ngx_lua_ver"
patch_file="$root/patches/ngx_lua-$ngx_lua_ver-rokfoss-config-test.patch"
info_txt=`perl -e 'print "\033[33m[INFO]\033[0m"'`

if [ ! -d "$ngx_lua_dir" ]; then
    echo "ROKFOSS Lua config test: ngx_lua source directory not found: $ngx_lua_dir" >&2
    exit 1
fi

if [ ! -f "$patch_file" ]; then
    echo "ROKFOSS Lua config test: patch file not found: $patch_file" >&2
    exit 1
fi

echo "$info_txt applying the ROKFOSS Lua config test patch"
cd "$ngx_lua_dir" || exit 1
patch -p1 < "$patch_file" || exit 1
cd "$root" || exit 1
echo

# mirror-tarballs-core already created the release archive. Rebuild it after
# applying the ROKFOSS ngx_lua patch so both the source tree and tarball carry
# exactly the same patched sources.
rm -f "$name.tar" "$name.tar.gz" || exit 1
tar cf "$name.tar" "$name" || exit 1
if command -v pigz > /dev/null 2>&1; then
    pigz -f --best "$name.tar" || exit 1
else
    gzip -f --best "$name.tar" || exit 1
fi
