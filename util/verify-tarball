#!/usr/bin/env bash

# 사용법: util/verify-tarball <파일> [<캐시파일>]
#
# 내려받은 소스 tarball 이 util/tarball-sha256 에 적힌 해시와 같은지 검증한다.
# util/get-tarball 이 다운로드 직후와 캐시 적중 시 모두 이 스크립트를 호출한다.
#
# 검증은 fail-closed 다. 아래 어느 경우든 <파일>과 <캐시파일>을 지우고
# 0이 아닌 코드로 끝난다.
#   - 해시 목록이 없거나 형식이 깨졌음
#   - 목록에 해당 파일명이 없거나 중복됨
#   - 계산한 해시가 목록과 다름 (gzip 해제 실패 포함)
#
# 해시 기준은 파일 이름 옆의 방식 표시로 정한다.
#   tar-sha256:  gzip 을 푼 tar 내용의 sha256 (기본, 모든 .tar.gz 에 사용)
#   file-sha256: 파일 바이트 그대로의 sha256 (gzip 이 아닌 파일 전용)
# GitHub 같은 호스트는 같은 내용을 다시 압축해 압축본 바이트가 달라질 수 있으므로
# tar 내용을 기준으로 삼는다. 실제로 tar -xzf 가 쓰는 바이트도 이 내용이다.

root=`perl -MCwd -e'print Cwd::abs_path(shift)' $(dirname -- "$0")/..`
hashfile=$root/util/tarball-sha256

# 해시 목록은 로케일과 상관없이 바이트로 읽는다. GNU grep 3.7(우분투 22.04 러너)은
# UTF-8 로케일에서 한글이 든 주석 줄을 정규식 '.' 로 처리하지 못하는 경우가 있다.
export LC_ALL=C

file=$1
cachefile=$2

if [ -z "$file" ]; then
    echo "사용법: util/verify-tarball <파일> [<캐시파일>]" >&2
    exit 2
fi

# 검증 실패 시 파일을 지우고(캐시 포함) 종료한다.
fail() {
    echo "" >&2
    echo "[오류] 소스 tarball 검증 실패: $name" >&2
    echo "  원인: $1" >&2
    echo "  조치: 변조되었을 수 있는 파일을 지웠습니다(내려받은 사본과 work/ 캐시 모두)." >&2
    shift
    for line in "$@"; do
        echo "  $line" >&2
    done
    rm -f -- "$file"
    if [ -n "$cachefile" ]; then
        rm -f -- "$cachefile"
    fi
    exit 1
}

name=$(basename -- "$file")

case "$name" in
    ''|.*|*[!A-Za-z0-9._+-]*)
        fail "파일 이름에 허용되지 않는 문자가 있습니다."
        ;;
esac

if [ ! -f "$hashfile" ]; then
    fail "해시 목록이 없습니다: $hashfile"
fi

# 목록 전체의 형식을 먼저 확인한다. 한 줄이라도 깨져 있으면 거부한다.
bad=$(grep -nv '^#' "$hashfile" | grep -vE '^[0-9]+:((tar|file)-sha256:[0-9a-f]{64}  [A-Za-z0-9._+-]+)?$' | head -n 1)
if [ -n "$bad" ]; then
    fail "해시 목록 형식이 올바르지 않습니다 ($hashfile, ${bad%%:*}번째 줄)."
fi

entry=$(awk -v n="$name" '/^#/ { next } $2 == n { print $1 }' "$hashfile")
count=$(printf '%s' "$entry" | grep -c .)

if [ "$count" -eq 0 ]; then
    fail "해시 목록에 이 파일이 없습니다." \
         "새 버전이면 내용을 직접 검토한 뒤 util/update-tarball-hashes 를 실행해" \
         "util/tarball-sha256 에 해시를 추가하고, 그 변경을 커밋 전에 확인하세요."
fi
if [ "$count" -ne 1 ]; then
    fail "해시 목록에 같은 파일이 $count 번 적혀 있습니다 ($hashfile)."
fi

method=${entry%%:*}
expected=${entry#*:}

if command -v sha256sum > /dev/null 2>&1; then
    sha256_cmd="sha256sum"
elif command -v shasum > /dev/null 2>&1; then
    sha256_cmd="shasum -a 256"
else
    fail "sha256sum 또는 shasum 명령이 필요합니다."
fi

set -o pipefail
case "$method" in
    tar-sha256)
        actual=$(gzip -dc -- "$file" 2> /dev/null | $sha256_cmd | cut -d' ' -f1)
        if [ $? -ne 0 ]; then
            fail "gzip 해제에 실패했습니다(gzip 파일이 아니거나 손상/뒤에 덧붙은 데이터가 있음)." \
                 "받은 파일이 오류 페이지이거나 변조된 파일일 수 있습니다."
        fi
        ;;
    file-sha256)
        actual=$($sha256_cmd < "$file" | cut -d' ' -f1)
        ;;
    *)
        fail "알 수 없는 해시 방식입니다: $method"
        ;;
esac

if [ "$actual" != "$expected" ]; then
    fail "해시가 목록과 다릅니다." \
         "방식: $method" \
         "기대: $expected" \
         "실제: $actual" \
         "업스트림이 같은 버전을 다시 만든 것이 아니라면 변조를 의심하세요." \
         "정상 변경임을 직접 확인했다면 util/update-tarball-hashes --accept-changed $name 으로 갱신합니다."
fi

echo "[검증 통과] $name"
