@@ -153,6 +153,88 @@ ngx_stream_lua_cache_store_code(lua_State *L, const char *key)
 }
 
 
+ngx_int_t
+ngx_stream_lua_rokfoss_test_inline(ngx_conf_t *cf, const char *tag,
+    const u_char *src, size_t src_len)
+{
+    int          rc;
+    lua_State   *L;
+    const char  *err;
+
+    /* nginx -t 와 nginx -s reload 두 경로에서만 검사한다 */
+    if (!ngx_test_config && !ngx_rokfoss_reload_test) {
+        return NGX_OK;
+    }
+
+    L = luaL_newstate();
+    if (L == NULL) {
+        ngx_conf_log_error(NGX_LOG_EMERG, cf, 0,
+                           "Stream Lua 문법 검사용 VM을 초기화하지 못했습니다");
+        return NGX_ERROR;
+    }
+
+    luaL_openlibs(L);
+
+    rc = ngx_stream_lua_clfactory_loadbuffer(L, (char *) src, src_len, tag);
+    if (rc != 0) {
+        err = lua_isstring(L, -1) ? lua_tostring(L, -1) : "unknown error";
+        ngx_conf_log_error(NGX_LOG_EMERG, cf, 0,
+                           "Stream Lua 문법 검사에 실패했습니다 (%s): %s",
+                           tag, err);
+        lua_close(L);
+        return NGX_ERROR;
+    }
+
+    lua_close(L);
+    return NGX_OK;
+}
+
+
+ngx_int_t
+ngx_stream_lua_rokfoss_test_file(ngx_conf_t *cf, const u_char *src,
+    size_t src_len)
+{
+    int          rc;
+    u_char      *script;
+    lua_State   *L;
+    const char  *err;
+
+    /* nginx -t 와 nginx -s reload 두 경로에서만 검사한다 */
+    if (!ngx_test_config && !ngx_rokfoss_reload_test) {
+        return NGX_OK;
+    }
+
+    script = ngx_stream_lua_rebase_path(cf->pool, (u_char *) src, src_len);
+    if (script == NULL) {
+        ngx_conf_log_error(NGX_LOG_EMERG, cf, 0,
+                           "Stream Lua 파일 경로를 확인하지 못했습니다");
+        return NGX_ERROR;
+    }
+
+    L = luaL_newstate();
+    if (L == NULL) {
+        ngx_conf_log_error(NGX_LOG_EMERG, cf, 0,
+                           "Stream Lua 파일 검사용 VM을 초기화하지 못했습니다");
+        return NGX_ERROR;
+    }
+
+    luaL_openlibs(L);
+
+    rc = ngx_stream_lua_clfactory_loadfile(L, (char *) script);
+    if (rc != 0) {
+        err = lua_isstring(L, -1) ? lua_tostring(L, -1) : "unknown error";
+        ngx_conf_log_error(NGX_LOG_EMERG, cf, 0,
+                           "Stream Lua 파일 검사에 실패했습니다 (\"%s\"): %s",
+                           script, err);
+        lua_close(L);
+        return NGX_ERROR;
+    }
+
+    lua_close(L);
+    return NGX_OK;
+}
+
+
 ngx_int_t
 ngx_stream_lua_cache_loadbuffer(ngx_log_t *log, lua_State *L,
     const u_char *src, size_t src_len, const u_char *cache_key,
