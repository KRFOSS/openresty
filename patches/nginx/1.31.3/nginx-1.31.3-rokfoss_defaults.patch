-    #log_format  main  '$remote_addr - $remote_user [$time_local] "$request" '
-    #                  '$status $body_bytes_sent "$http_referer" '
-    #                  '"$http_user_agent" "$http_x_forwarded_for"';
+    # Safe fallback values for builds without ngx_http_geoip2_module.
+    # GeoIP2-enabled deployments should replace these maps with geoip2 blocks.
+    map "" $geoip2_data_country_code {
+        default "US";
+    }
+
+    map "" $geoip2_data_city {
+        default "-";
+    }
+
+    map "" $geoip2_data_asn {
+        default "";
+    }
+
+    map "" $geoip2_data_org {
+        default "-";
+    }
+
+    map $geoip2_data_asn $formatted_asn {
+        default "AS$geoip2_data_asn";
+        ""      "-";
+    }
+
+    map $time_local $custom_time {
+        default "$time_iso8601";
+    }
+
+    map $request_method $request_body_log {
+        default "";
+        POST    $request_body;
+    }
+
+    log_format custom escape=none '$custom_time | $remote_addr | $host | $geoip2_data_country_code | $geoip2_data_city | [$formatted_asn $geoip2_data_org] | $request_uri | $status | $http_user_agent | $request_method | $http_referer | $request_body_log | $server_protocol';
 
-    #access_log  logs/access.log  main;
+    access_log  logs/access.log  custom;
 
     sendfile        on;
     #tcp_nopush     on;
