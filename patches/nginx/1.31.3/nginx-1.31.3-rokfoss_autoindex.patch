+/*
+ * ROKFOSS: 파일명을 <script> 안 JSON 문자열에 안전하게 넣기 위한 이스케이프.
+ *
+ * ngx_escape_json 은 " \ 와 제어문자만 처리한다. 그런데 파일명은 동기화로
+ * 들어오는 신뢰할 수 없는 값이라 "</script>" 가 들어 있으면 HTML 파서가
+ * 스크립트를 거기서 끊어버린다(JSON 문법과 무관한 XSS). 그래서 < > 도
+ * < > 로 바꾼다. 0x80 이상 바이트(UTF-8, 한글 등)는 그대로 둔다.
+ *
+ * dst 가 NULL 이면 원본 대비 늘어나는 바이트 수만 센다.
+ */
+static uintptr_t
+ngx_http_autoindex_rokfoss_escape(u_char *dst, u_char *src, size_t size)
+{
+    u_char      ch;
+    ngx_uint_t  len;
+
+    if (dst == NULL) {
+        len = 0;
+
+        while (size) {
+            ch = *src++;
+            size--;
+
+            if (ch == '"' || ch == '\\' || ch == '\b' || ch == '\f'
+                || ch == '\n' || ch == '\r' || ch == '\t')
+            {
+                len += 1;
+
+            } else if (ch == '<' || ch == '>' || ch < 0x20) {
+                len += sizeof("\\u001F") - 2;
+            }
+        }
+
+        return (uintptr_t) len;
+    }
+
+    while (size) {
+        ch = *src++;
+        size--;
+
+        if (ch > 0x1f && ch != '"' && ch != '\\' && ch != '<' && ch != '>') {
+            *dst++ = ch;
+            continue;
+        }
+
+        switch (ch) {
+        case '"':  *dst++ = '\\'; *dst++ = '"';  break;
+        case '\\': *dst++ = '\\'; *dst++ = '\\'; break;
+        case '\b': *dst++ = '\\'; *dst++ = 'b';  break;
+        case '\f': *dst++ = '\\'; *dst++ = 'f';  break;
+        case '\n': *dst++ = '\\'; *dst++ = 'n';  break;
+        case '\r': *dst++ = '\\'; *dst++ = 'r';  break;
+        case '\t': *dst++ = '\\'; *dst++ = 't';  break;
+        default:
+            /* < > 와 나머지 제어문자는 \u00XX 로 */
+            *dst++ = '\\'; *dst++ = 'u'; *dst++ = '0'; *dst++ = '0';
+            *dst++ = "0123456789abcdef"[ch >> 4];
+            *dst++ = "0123456789abcdef"[ch & 0xf];
+        }
+    }
+
+    return (uintptr_t) dst;
+}
