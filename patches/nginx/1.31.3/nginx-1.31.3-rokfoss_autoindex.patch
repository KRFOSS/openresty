+/*
+ * ROKFOSS: 커스텀 디렉터리 화면.
+ *
+ * 검증된 nginx JSON 직렬화(name/type/mtime/size)를 그대로 쓰되, 정적 껍데기
+ * (head + CSS + JS) 로 감싼다. 브라우저에는 행 HTML 을 보내지 않는다. 데이터만
+ * 보내고 화면에 보이는 만큼만 그려서 수천 개 디렉터리에서도 멈추지 않는다.
+ */
+static ngx_buf_t *
+ngx_http_autoindex_rokfoss(ngx_http_request_t *r, ngx_array_t *entries)
+{
+    size_t                       len, entry_len;
+    ngx_buf_t                   *b;
+    ngx_uint_t                   i;
+    ngx_http_autoindex_entry_t  *entry;
+
+    len = sizeof(ngx_http_rokfoss_autoindex_head) - 1
+        + sizeof(ngx_http_rokfoss_autoindex_tail) - 1
+        + sizeof("[]") - 1;
+
+    entry = entries->elts;
+
+    for (i = 0; i < entries->nelts; i++) {
+        entry[i].escape = ngx_http_autoindex_rokfoss_escape(NULL,
+                                                            entry[i].name.data,
+                                                            entry[i].name.len);
+
+        entry_len = sizeof("{\"name\":\"\",\"type\":\"directory\","
+                           "\"mtime\":\"Wed, 31 Dec 1986 10:00:00 GMT\"},") - 1
+                  + entry[i].name.len + entry[i].escape;
+
+        if (entry[i].file) {
+            entry_len += sizeof(",\"size\":") - 1 + NGX_OFF_T_LEN;
+        }
+
+        if (len > NGX_MAX_SIZE_T_VALUE - entry_len) {
+            return NULL;
+        }
+
+        len += entry_len;
+    }
+
+    b = ngx_create_temp_buf(r->pool, len);
+    if (b == NULL) {
+        return NULL;
+    }
+
+    b->last = ngx_cpymem(b->last, ngx_http_rokfoss_autoindex_head,
+                         sizeof(ngx_http_rokfoss_autoindex_head) - 1);
+
+    *b->last++ = '[';
+
+    for (i = 0; i < entries->nelts; i++) {
+        if (i > 0) {
+            *b->last++ = ',';
+        }
+
+        b->last = ngx_cpymem(b->last, "{\"name\":\"",
+                             sizeof("{\"name\":\"") - 1);
+
+        if (entry[i].escape) {
+            b->last = (u_char *) ngx_http_autoindex_rokfoss_escape(b->last,
+                                                            entry[i].name.data,
+                                                            entry[i].name.len);
+        } else {
+            b->last = ngx_cpymem(b->last, entry[i].name.data,
+                                 entry[i].name.len);
+        }
+
+        b->last = ngx_cpymem(b->last, "\",\"type\":\"",
+                             sizeof("\",\"type\":\"") - 1);
+
+        if (entry[i].dir) {
+            b->last = ngx_cpymem(b->last, "directory", sizeof("directory") - 1);
+
+        } else if (entry[i].file) {
+            b->last = ngx_cpymem(b->last, "file", sizeof("file") - 1);
+
+        } else {
+            b->last = ngx_cpymem(b->last, "other", sizeof("other") - 1);
+        }
+
+        b->last = ngx_cpymem(b->last, "\",\"mtime\":\"",
+                             sizeof("\",\"mtime\":\"") - 1);
+
+        b->last = ngx_http_time(b->last, entry[i].mtime);
+
+        if (entry[i].file) {
+            b->last = ngx_cpymem(b->last, "\",\"size\":",
+                                 sizeof("\",\"size\":") - 1);
+            b->last = ngx_sprintf(b->last, "%O", entry[i].size);
+
+        } else {
+            *b->last++ = '"';
+        }
+
+        *b->last++ = '}';
+    }
+
+    *b->last++ = ']';
+
+    b->last = ngx_cpymem(b->last, ngx_http_rokfoss_autoindex_tail,
+                         sizeof(ngx_http_rokfoss_autoindex_tail) - 1);
+
+    return b;
+}
