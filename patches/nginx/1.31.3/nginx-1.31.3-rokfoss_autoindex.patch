+    "});\r\n"
+    "\r\n"
+    "var heads = document.querySelectorAll('.idx-h');\r\n"
+    "for (var k = 0; k < heads.length; k++) {\r\n"
+    "  (function(btn){\r\n"
+    "    btn.addEventListener('click', function(){\r\n"
+    "      var key = btn.getAttribute('data-sort');\r\n"
+    "      if (sortKey === key) { sortAsc = !sortAsc; }\r\n"
+    "      else { sortKey = key; sortAsc = true; }\r\n"
