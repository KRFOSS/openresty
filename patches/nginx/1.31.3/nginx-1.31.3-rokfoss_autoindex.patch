+    "  else r = a.lower < b.lower ? -1 : (a.lower > b.lower ? 1 : 0);\r\n"
+    "  return sortAsc ? r : -r;\r\n"
+    "}\r\n"
+    "\r\n"
+    "var view = items.slice().sort(cmp);\r\n"
