+/*
+ * ROKFOSS: 커스텀 디렉터리 화면.
+ *
+ * 검증된 nginx JSON 직렬화(name/type/mtime/size)를 그대로 쓰되, 정적 껍데기
+ * (head + CSS + JS) 로 감싼다. 브라우저에는 행 HTML 을 보내지 않는다. 데이터만
+ * 보내고 화면에 보이는 만큼만 그려서 수천 개 디렉터리에서도 멈추지 않는다.
+ */
+static ngx_buf_t *
+ngx_http_autoindex_rokfoss(ngx_http_request_t *r, ngx_array_t *entries)
+{
+    u_char                         *head, *tail;
+    size_t                          len, entry_len, head_len, tail_len;
+    ngx_buf_t                      *b;
+    ngx_uint_t                      i;
+    ngx_http_autoindex_entry_t     *entry;
+    ngx_http_autoindex_loc_conf_t  *alcf;
+
+    alcf = ngx_http_get_module_loc_conf(r, ngx_http_autoindex_module);
+
+    /* autoindex_header/footer 가 지정되면 그 파일(RAM)을, 아니면 내장 기본값을 */
+    if (alcf->rokfoss_header.len) {
+        head = alcf->rokfoss_header.data;
+        head_len = alcf->rokfoss_header.len;
+    } else {
+        head = ngx_http_rokfoss_autoindex_head;
+        head_len = sizeof(ngx_http_rokfoss_autoindex_head) - 1;
+    }
+
+    if (alcf->rokfoss_footer.len) {
+        tail = alcf->rokfoss_footer.data;
+        tail_len = alcf->rokfoss_footer.len;
+    } else {
+        tail = ngx_http_rokfoss_autoindex_tail;
+        tail_len = sizeof(ngx_http_rokfoss_autoindex_tail) - 1;
+    }
+
+    len = head_len + tail_len + sizeof("[]") - 1;
+
+    entry = entries->elts;
+
+    for (i = 0; i < entries->nelts; i++) {
+        entry[i].escape = ngx_http_autoindex_rokfoss_escape(NULL,
+                                                            entry[i].name.data,
+                                                            entry[i].name.len);
