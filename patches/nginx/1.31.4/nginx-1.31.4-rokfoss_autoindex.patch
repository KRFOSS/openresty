+/*
+ * ROKFOSS: autoindex_header / autoindex_footer 파일을 설정 로드 시 한 번 읽어
+ * 그 내용을 loc_conf(RAM)에 담는다.
+ *
+ * 요청마다 파일을 읽지 않는다. 마스터가 설정을 읽을 때 한 번 읽고, 워커는
+ * fork 로 그 메모리를 공유한다. 미러 파일이 몇 개든 캐시는 이 두 파일뿐이다.
+ * 디자인을 바꾸면 nginx -s reload 로 다시 읽힌다.
+ */
+static char *
+ngx_http_autoindex_rokfoss_template(ngx_conf_t *cf, ngx_command_t *cmd,
+    void *conf)
+{
+    char             *p = conf;
+    ngx_str_t        *dst, *value, name;
+    ssize_t           n;
+    ngx_file_t        file;
+    ngx_file_info_t   fi;
+
+    dst = (ngx_str_t *) (p + cmd->offset);
+
+    if (dst->data) {
+        return "is duplicate";
+    }
+
+    value = cf->args->elts;
+    name = value[1];
+
+    if (ngx_conf_full_name(cf->cycle, &name, 0) != NGX_OK) {
+        return NGX_CONF_ERROR;
+    }
+
+    ngx_memzero(&file, sizeof(ngx_file_t));
+    file.name = name;
+    file.log = cf->log;
+
+    file.fd = ngx_open_file(name.data, NGX_FILE_RDONLY, NGX_FILE_OPEN, 0);
+    if (file.fd == NGX_INVALID_FILE) {
+        ngx_conf_log_error(NGX_LOG_EMERG, cf, ngx_errno,
+                           ngx_open_file_n " \"%V\" failed", &name);
+        return NGX_CONF_ERROR;
+    }
+
+    if (ngx_fd_info(file.fd, &fi) == NGX_FILE_ERROR) {
+        ngx_conf_log_error(NGX_LOG_EMERG, cf, ngx_errno,
+                           ngx_fd_info_n " \"%V\" failed", &name);
+        goto failed;
+    }
+
+    dst->len = (size_t) ngx_file_size(&fi);
+
+    if (dst->len == 0) {
+        ngx_conf_log_error(NGX_LOG_EMERG, cf, 0,
+                           "autoindex template \"%V\" is empty", &name);
+        goto failed;
+    }
+
+    dst->data = ngx_palloc(cf->pool, dst->len);
+    if (dst->data == NULL) {
+        goto failed;
+    }
+
+    n = ngx_read_file(&file, dst->data, dst->len, 0);
+    if (n == NGX_ERROR) {
+        ngx_conf_log_error(NGX_LOG_EMERG, cf, ngx_errno,
+                           ngx_read_file_n " \"%V\" failed", &name);
+        goto failed;
+    }
+
+    if ((size_t) n != dst->len) {
+        ngx_conf_log_error(NGX_LOG_EMERG, cf, 0,
+                           ngx_read_file_n " \"%V\" returned only %z of %uz",
+                           &name, n, dst->len);
+        goto failed;
+    }
+
+    if (ngx_close_file(file.fd) == NGX_FILE_ERROR) {
+        ngx_conf_log_error(NGX_LOG_ALERT, cf, ngx_errno,
+                           ngx_close_file_n " \"%V\" failed", &name);
+    }
+
+    return NGX_CONF_OK;
+
+failed:
+
+    if (ngx_close_file(file.fd) == NGX_FILE_ERROR) {
+        ngx_conf_log_error(NGX_LOG_ALERT, cf, ngx_errno,
+                           ngx_close_file_n " \"%V\" failed", &name);
+    }
+
+    return NGX_CONF_ERROR;
+}
