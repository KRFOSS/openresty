 static ngx_int_t
 ngx_http_core_postconfiguration(ngx_conf_t *cf)
 {
+    ngx_http_handler_pt        *h;
+    ngx_http_core_main_conf_t  *cmcf;
+
     ngx_http_top_request_body_filter = ngx_http_request_body_save_filter;
 
+    /*
+     * ROKFOSS: drop_all 을 preaccess 단계에서도 검사한다.
+     *
+     * find_config 단계 검사는 if 평가 전에 돌기 때문에 if 안에 넣은 drop_all
+     * 은 못 본다. preaccess 는 rewrite/if 평가가 끝난 뒤라, if 가 matched 되어
+     * loc_conf 가 교체된 상태를 본다. 그래서 여기서 다시 확인하면
+     * "if (...) { drop_all on; }" 도 동작한다. 본문을 읽기 전이라 조기 종료.
+     */
+    cmcf = ngx_http_conf_get_module_main_conf(cf, ngx_http_core_module);
+
+    h = ngx_array_push(&cmcf->phases[NGX_HTTP_PREACCESS_PHASE].handlers);
+    if (h == NULL) {
+        return NGX_ERROR;
+    }
+
+    *h = ngx_http_rokfoss_drop_handler;
+
     return NGX_OK;
 }
 
 
+/*
+ * ROKFOSS: if 로 켜진 drop_all 을 처리하는 preaccess 핸들러.
+ * 반환한 NGX_HTTP_CLOSE 를 단계 엔진이 finalize 해 응답 없이 연결을 끊는다.
+ */
+static ngx_int_t
+ngx_http_rokfoss_drop_handler(ngx_http_request_t *r)
+{
+    ngx_http_core_loc_conf_t  *clcf;
+
+    clcf = ngx_http_get_module_loc_conf(r, ngx_http_core_module);
+
+    if (!clcf->drop_all) {
+        return NGX_DECLINED;
+    }
+
+    ngx_log_error(NGX_LOG_INFO, r->connection->log, 0,
+                  "dropped by drop_all: \"%V?%V\"", &r->uri, &r->args);
+
+    r->err_status = NGX_HTTP_ROKFOSS_DROP;
+    r->keepalive = 0;
+    r->lingering_close = 0;
+
+    return NGX_HTTP_CLOSE;
+}
