+void
+ngx_http_rokfoss_cache_key_warn(ngx_conf_t *cf, ngx_str_t *directive,
+    ngx_str_t *key)
+{
+    u_char      *p, *last, *name;
+    size_t       len;
+    ngx_uint_t   braced;
+
+    p = key->data;
+    last = key->data + key->len;
+
+    while (p < last) {
+
+        p = ngx_strlchr(p, last, '$');
+        if (p == NULL) {
+            return;
+        }
+
+        p++;
+
+        if (p < last && *p == '{') {
+            braced = 1;
+            p++;
+
+        } else {
+            braced = 0;
+        }
+
+        name = p;
+
+        while (p < last
+               && ((*p >= 'a' && *p <= 'z')
+                   || (*p >= 'A' && *p <= 'Z')
+                   || (*p >= '0' && *p <= '9')
+                   || *p == '_'))
+        {
+            p++;
+        }
+
+        len = p - name;
+
+        if (braced && p < last && *p == '}') {
+            p++;
+        }
+
+        if ((len == 3 && ngx_strncmp(name, "uri", 3) == 0)
+            || (len == 12 && ngx_strncmp(name, "document_uri", 12) == 0))
+        {
+            ngx_conf_log_error(NGX_LOG_WARN, cf, 0,
+                "주의: %V 에 $uri 를 쓰면 정규화된 경로로 캐시 키가 만들어져 "
+                "위험이 있을 수 있으니 보안상 $request_uri 로 수정하는 것을 "
+                "권장합니다",
+                directive);
+
+            return;
+        }
+    }
+}
