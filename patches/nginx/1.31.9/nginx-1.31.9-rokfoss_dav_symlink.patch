+static ngx_int_t
+ngx_http_dav_check_symlinks(ngx_http_request_t *r, ngx_str_t *path)
+{
+    u_char                    *p, ch;
+    ngx_file_info_t            fi;
+    ngx_open_file_info_t       of;
+    ngx_http_core_loc_conf_t  *clcf;
+
+    clcf = ngx_http_get_module_loc_conf(r, ngx_http_core_module);
+
+    if (clcf->disable_symlinks == NGX_DISABLE_SYMLINKS_OFF) {
+        return NGX_OK;
+    }
+
+    ngx_memzero(&of, sizeof(ngx_open_file_info_t));
+
+    of.test_only = 1;
+    of.valid = clcf->open_file_cache_valid;
+    of.min_uses = clcf->open_file_cache_min_uses;
+    of.errors = clcf->open_file_cache_errors;
+    of.events = clcf->open_file_cache_events;
+
+    if (ngx_http_set_disable_symlinks(r, clcf, path, &of) != NGX_OK) {
+        return NGX_HTTP_INTERNAL_SERVER_ERROR;
+    }
+
+    /*
+     * On Linux, openat(O_NOFOLLOW) on an intermediate symlink may report
+     * ENOTDIR instead of ELOOP.  ENOTDIR is treated as a create-allowed
+     * case below, so check path components explicitly for the strict "on"
+     * mode before deciding that a write may proceed.
+     */
+    if (clcf->disable_symlinks == NGX_DISABLE_SYMLINKS_ON) {
+        p = path->data;
+
+        while (p < path->data + path->len) {
+            if (*p == '/') {
+                p++;
+                continue;
+            }
+
+            while (p < path->data + path->len && *p && *p != '/') {
+                p++;
+            }
+
+            ch = *p;
+            *p = '\0';
+
+            if (ngx_link_info(path->data, &fi) != NGX_FILE_ERROR
+                && ngx_is_link(&fi))
+            {
+                *p = ch;
+
+                ngx_log_error(NGX_LOG_ERR, r->connection->log, 0,
+                              "symlinked path could not be used "
+                              "(disable_symlinks)");
+
+                return NGX_HTTP_FORBIDDEN;
+            }
+
+            *p = ch;
+
+            if (ch == '\0') {
+                break;
+            }
+        }
+    }
+
+    if (ngx_open_cached_file(clcf->open_file_cache, path, &of, r->pool)
+        == NGX_OK)
+    {
+        return NGX_OK;
+    }
+
+    switch (of.err) {
+
+    case NGX_ENOENT:
+    case NGX_ENOTDIR:
+        /* the object is about to be created */
+        return NGX_OK;
+
+    case NGX_ELOOP:
+        ngx_log_error(NGX_LOG_ERR, r->connection->log, of.err,
+                      "symlinked path could not be used (disable_symlinks)");
+        return NGX_HTTP_FORBIDDEN;
+
+    default:
+        /*
+         * Do not turn EACCES (and similar) into 403: write-only files may
+         * legitimately be unreadable by the worker.
+         */
+        ngx_log_error(NGX_LOG_WARN, r->connection->log, of.err,
+                      "DAV symlink pre-check could not verify \"%V\", "
+                      "allowing the operation", path);
+        return NGX_OK;
+    }
+}
