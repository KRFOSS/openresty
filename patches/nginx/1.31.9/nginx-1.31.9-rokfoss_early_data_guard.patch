+/*
+ * ROKFOSS: 0-RTT로 온 비멱등 요청을 서버가 스스로 거부한다.
+ *
+ * nginx는 OpenSSL anti-replay를 끄고 자체 세션 캐시를 쓰므로 같은 티켓으로
+ * 재전송한 0-RTT 요청이 여러 번 실행된다. RFC 8446 section 8에 따라
+ * 멱등 메서드(GET/HEAD/OPTIONS)만 0-RTT를 허용하고 나머지는 425로 되돌린다.
+ * r->args는 로그에 넣지 않는다 (길이 0일 때 data가 NULL).
+ */
+ngx_int_t
+ngx_http_rokfoss_early_data_guard(ngx_http_request_t *r)
+{
+    ngx_str_t                  early;
+    ngx_http_ssl_srv_conf_t   *sscf;
+
+    if (r->connection->ssl == NULL) {
+        return NGX_DECLINED;
+    }
+
+    sscf = ngx_http_get_module_srv_conf(r, ngx_http_ssl_module);
+
+    if (!sscf->early_data_idempotent_only) {
+        return NGX_DECLINED;
+    }
+
+    if (ngx_ssl_get_early_data(r->connection, r->pool, &early) != NGX_OK) {
+        return NGX_DECLINED;
+    }
+
+    if (early.len != 1 || early.data[0] != '1') {
+        return NGX_DECLINED;
+    }
+
+    if (r->method == NGX_HTTP_GET || r->method == NGX_HTTP_HEAD
+        || r->method == NGX_HTTP_OPTIONS)
+    {
+        return NGX_DECLINED;
+    }
+
+    ngx_log_error(NGX_LOG_INFO, r->connection->log, 0,
+                  "0-RTT 로 온 비멱등 요청을 거부했습니다: \"%V %V\"",
+                  &r->method_name, &r->uri);
+
+    return NGX_HTTP_TOO_EARLY;
+}
+
+
+static ngx_int_t
+ngx_http_ssl_early_data_handler(ngx_http_request_t *r)
+{
+    return ngx_http_rokfoss_early_data_guard(r);
+}
+
