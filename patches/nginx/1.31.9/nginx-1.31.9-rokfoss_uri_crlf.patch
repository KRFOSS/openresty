diff --git a/src/http/ngx_http_parse.c b/src/http/ngx_http_parse.c
index c69d8ef..5473214 100644
--- a/src/http/ngx_http_parse.c
+++ b/src/http/ngx_http_parse.c
@@ -1563,7 +1563,8 @@ ngx_http_parse_complex_uri(ngx_http_request_t *r, ngx_uint_t merge_slashes)
                     ch = *p++;
                     break;
 
-                } else if (ch == '\0') {
+                } else if (ch < 0x20) {
+                    /* 디코드된 제어문자(NUL 포함)는 헤더·로그 주입에 쓰이므로 거부 */
                     return NGX_HTTP_PARSE_INVALID_REQUEST;
                 }
 
@@ -1583,6 +1584,10 @@ ngx_http_parse_complex_uri(ngx_http_request_t *r, ngx_uint_t merge_slashes)
 
                 } else if (ch == '+') {
                     r->plus_in_uri = 1;
+
+                } else if (ch < 0x20 || ch == 0x7f) {
+                    /* 디코드된 제어문자(CR/LF 포함)와 DEL 은 헤더·로그 주입을 막으려고 거부 */
+                    return NGX_HTTP_PARSE_INVALID_REQUEST;
                 }
 
                 state = quoted_state;
@@ -1924,6 +1929,10 @@ ngx_http_parse_unsafe_uri(ngx_http_request_t *r, ngx_str_t *uri,
             goto unsafe;
         }
 
+        if (ch < 0x20 || ch == 0x7f) {
+            goto unsafe_ctl;
+        }
+
         if (ngx_path_separator(ch) && len > 2) {
 
             /* detect "/../" and "/.." */
@@ -1973,6 +1982,10 @@ ngx_http_parse_unsafe_uri(ngx_http_request_t *r, ngx_str_t *uri,
                 goto unsafe;
             }
 
+            if (ch < 0x20 || ch == 0x7f) {
+                goto unsafe_ctl;
+            }
+
             if (ngx_path_separator(ch) && len > 2) {
 
                 /* detect "/../" and "/.." */
@@ -1995,6 +2008,17 @@ unsafe:
                       "unsafe URI \"%V\" was detected", uri);
     }
 
+    return NGX_ERROR;
+
+unsafe_ctl:
+
+    /* 제어문자가 든 URI 는 로그에 원문을 찍지 않는다(로그 줄 주입 방지) */
+
+    if (*flags & NGX_HTTP_LOG_UNSAFE) {
+        ngx_log_error(NGX_LOG_ERR, r->connection->log, 0,
+                      "URI with a control character was rejected");
+    }
+
     return NGX_ERROR;
 }
 
