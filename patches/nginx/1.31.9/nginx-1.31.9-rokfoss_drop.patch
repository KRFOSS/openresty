+/*
+ * ROKFOSS: drop_all 공통 판정. 끊어야 하면 1, 통과시키면 0 을 돌려준다.
+ *
+ *  - drop_all 이 꺼진 곳: 항상 0. 순정 nginx 와 동작이 1바이트도 다르지 않다.
+ *  - 본문 크기를 선언했고(r->headers_in.content_length_n != -1) 그 값이
+ *    client_max_body_size 를 넘으면 0. 드롭하지 않고 nginx 가 정상 413
+ *    오류 페이지를 돌려준다. "413(본문 초과)은 제외한다, 용량을 넘겨
+ *    업로드하는 정상 사용자에게는 이유를 알려주어야 한다"는 패치 주석의
+ *    의도를 실제 동작과 일치시키는 예외다. client_max_body_size 가 0이면
+ *    무제한이므로 이 분기에 들어가지 않는다.
+ *  - 청크 인코딩처럼 크기를 모르는 본문(content_length_n == -1)은 1.
+ *    사전에 초과 여부를 알 수 없고, 스캐너 트래픽을 조용히 차단하는 목적이
+ *    우선이므로 지금처럼 드롭한다.
+ *  - GET/HEAD 처럼 본문이 없는 요청, 한도 이내의 본문도 1 (기존 드롭 유지).
+ *
+ * nginx 의 413 검문은 find_config 단계에서 이 판정 바로 뒤에 있다. 따라서
+ * find_config 를 지나는 요청은 큰 본문 선언이면 413 이 되고, 같은 location
+ * 의 return 보다 413 이 먼저 이긴다. 반면 이름있는 location 처럼
+ * find_config 를 건너뛰는 경로는 nginx 413 검문을 타지 않아 return 경로의
+ * 기존 드롭이 그대로 살아 있다. 이 차이는 nginx 단계 순서의 결과이며
+ * 의도된 동작이다. rewrite 의 return 과 special_response 의
+ * 400/414/495/496/497 처리는 이 헬퍼를 쓰지 않는다.
+ */
+static ngx_int_t
+ngx_http_rokfoss_should_drop(ngx_http_request_t *r,
+    ngx_http_core_loc_conf_t *clcf)
+{
+    if (!clcf->drop_all) {
+        return 0;
+    }
+
+    if (r->headers_in.content_length_n != -1
+        && clcf->client_max_body_size != 0
+        && clcf->client_max_body_size < r->headers_in.content_length_n)
+    {
+        return 0;
+    }
+
+    return 1;
+}
+
+
+/*
+ * ROKFOSS: if 로 켜진 drop_all 을 처리하는 preaccess 핸들러.
+ * 반환한 NGX_HTTP_CLOSE 를 단계 엔진이 finalize 해 응답 없이 연결을 끊는다.
+ */
+static ngx_int_t
+ngx_http_rokfoss_drop_handler(ngx_http_request_t *r)
+{
+    ngx_http_core_loc_conf_t  *clcf;
+
+    clcf = ngx_http_get_module_loc_conf(r, ngx_http_core_module);
+
+    if (!ngx_http_rokfoss_should_drop(r, clcf)) {
+        return NGX_DECLINED;
+    }
+
+    if (r->args.len) {
+        ngx_log_error(NGX_LOG_INFO, r->connection->log, 0,
+                      "dropped by drop_all: \"%V?%V\"", &r->uri, &r->args);
+
+    } else {
+        ngx_log_error(NGX_LOG_INFO, r->connection->log, 0,
+                      "dropped by drop_all: \"%V\"", &r->uri);
+    }
+
+    r->err_status = NGX_HTTP_ROKFOSS_DROP;
+    r->keepalive = 0;
+    r->lingering_close = 0;
+
+    return NGX_HTTP_CLOSE;
+}
