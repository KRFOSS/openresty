diff --git a/src/core/ngx_cycle.c b/src/core/ngx_cycle.c
index 8560797..99ac2ca 100644
--- a/src/core/ngx_cycle.c
+++ b/src/core/ngx_cycle.c
@@ -28,6 +28,72 @@ static ngx_event_t     ngx_shutdown_event;
 ngx_uint_t             ngx_test_config;
 ngx_uint_t             ngx_dump_config;
 ngx_uint_t             ngx_quiet_mode;
+ngx_uint_t             ngx_rokfoss_reload_test;
+
+
+ngx_str_t *
+ngx_rokfoss_escape_path(ngx_pool_t *pool, ngx_str_t *src)
+{
+    u_char              *p, *dst, c;
+    ngx_str_t           *escaped;
+    size_t               i, len;
+
+    static u_char        hex[] = "0123456789abcdef";
+
+
+    if (pool == NULL || src == NULL || src->data == NULL) {
+        return NULL;
+    }
+
+    if (src->len > ((size_t) -1) / 4) {
+        return NULL;
+    }
+
+    len = 0;
+
+    for (i = 0; i < src->len; i++) {
+        c = src->data[i];
+
+        if (c < 0x20 || c == 0x7f) {
+            len += 4;
+
+        } else {
+            len++;
+        }
+    }
+
+    escaped = ngx_pnalloc(pool, sizeof(ngx_str_t));
+    if (escaped == NULL) {
+        return NULL;
+    }
+
+    dst = ngx_pnalloc(pool, len + 1);
+    if (dst == NULL) {
+        return NULL;
+    }
+
+    escaped->len = len;
+    escaped->data = dst;
+    p = dst;
+
+    for (i = 0; i < src->len; i++) {
+        c = src->data[i];
+
+        if (c < 0x20 || c == 0x7f) {
+            *p++ = '\\';
+            *p++ = 'x';
+            *p++ = hex[c >> 4];
+            *p++ = hex[c & 0x0f];
+
+        } else {
+            *p++ = c;
+        }
+    }
+
+    *p = '\0';
+
+    return escaped;
+}
 
 
