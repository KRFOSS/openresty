+static ngx_int_t
+ngx_http_lua_rokfoss_test_inline(ngx_conf_t *cf, const char *tag,
+    const u_char *src, size_t src_len)
+{
+    int          rc;
+    lua_State   *L;
+    const char  *err;
+
+    if (!ngx_test_config) {
+        return NGX_OK;
+    }
+
+    L = luaL_newstate();
+    if (L == NULL) {
+        ngx_conf_log_error(NGX_LOG_EMERG, cf, 0,
+                           "Lua 문법 검사용 VM을 초기화하지 못했습니다");
+        return NGX_ERROR;
+    }
+
+    luaL_openlibs(L);
+
+    rc = ngx_http_lua_clfactory_loadbuffer(L, (char *) src, src_len, tag);
+    if (rc != 0) {
+        err = lua_isstring(L, -1) ? lua_tostring(L, -1) : "unknown error";
+
+        ngx_conf_log_error(NGX_LOG_EMERG, cf, 0,
+                           "Lua 문법 검사에 실패했습니다 (%s): %s",
+                           tag, err);
+        lua_close(L);
+        return NGX_ERROR;
+    }
+
+    lua_close(L);
+    return NGX_OK;
+}
+
+
+static ngx_int_t
+ngx_http_lua_rokfoss_test_file(ngx_conf_t *cf, const u_char *src,
+    size_t src_len)
+{
+    int          rc;
+    u_char      *script;
+    lua_State   *L;
+    const char  *err;
+
+    if (!ngx_test_config) {
+        return NGX_OK;
