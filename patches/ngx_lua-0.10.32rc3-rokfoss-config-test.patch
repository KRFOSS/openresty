+    script = ngx_http_lua_rebase_path(cf->pool, (u_char *) src, src_len);
+    if (script == NULL) {
+        ngx_conf_log_error(NGX_LOG_EMERG, cf, 0,
+                           "Lua 파일 경로를 확인하지 못했습니다");
+        return NGX_ERROR;
+    }
+
+    L = luaL_newstate();
+    if (L == NULL) {
+        ngx_conf_log_error(NGX_LOG_EMERG, cf, 0,
+                           "Lua 파일 검사용 VM을 초기화하지 못했습니다");
+        return NGX_ERROR;
+    }
+
+    luaL_openlibs(L);
+
+    rc = ngx_http_lua_clfactory_loadfile(L, (char *) script);
+    if (rc != 0) {
+        err = lua_isstring(L, -1) ? lua_tostring(L, -1) : "unknown error";
+
+        ngx_conf_log_error(NGX_LOG_EMERG, cf, 0,
+                           "Lua 파일 검사에 실패했습니다 (\"%s\"): %s",
+                           script, err);
+        lua_close(L);
+        return NGX_ERROR;
+    }
+
+    lua_close(L);
+    return NGX_OK;
+}
