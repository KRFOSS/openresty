+static ngx_uint_t
+ngx_http_lua_rokfoss_error_line(ngx_conf_t *cf, const char *err)
+{
+    u_char                    *p, *q;
+    ngx_int_t                  parsed;
+    ngx_http_lua_main_conf_t  *lmcf;
+
+    for (p = (u_char *) err; *p != '\0'; p++) {
+        if (*p != ':' || p[1] < '0' || p[1] > '9') {
+            continue;
+        }
+
+        for (q = p + 1; *q >= '0' && *q <= '9'; q++) {
+            /* void */
+        }
+
+        if (*q != ':') {
+            continue;
+        }
+
+        parsed = ngx_atoi(p + 1, q - (p + 1));
+        if (parsed <= 0) {
+            continue;
+        }
+
+        lmcf = ngx_http_conf_get_module_main_conf(cf, ngx_http_lua_module);
+        if (lmcf->directive_line > 0) {
+            return lmcf->directive_line + (ngx_uint_t) parsed - 1;
+        }
+    }
+
+    return cf->conf_file->line;
+}
+
+
+ngx_int_t
+ngx_http_lua_rokfoss_test_inline(ngx_conf_t *cf, const char *tag,
+    const u_char *src, size_t src_len)
+{
+    int          rc;
+    lua_State   *L;
+    const char  *err;
+    ngx_uint_t   saved_line;
+
+    if (!ngx_test_config) {
+        return NGX_OK;
+    }
+
+    L = luaL_newstate();
+    if (L == NULL) {
+        ngx_conf_log_error(NGX_LOG_EMERG, cf, 0,
+                           "Lua 문법 검사용 VM을 초기화하지 못했습니다");
+        return NGX_ERROR;
+    }
+
+    luaL_openlibs(L);
+
+    rc = ngx_http_lua_clfactory_loadbuffer(L, (char *) src, src_len, tag);
+    if (rc != 0) {
+        err = lua_isstring(L, -1) ? lua_tostring(L, -1) : "unknown error";
+
+        saved_line = cf->conf_file->line;
+        cf->conf_file->line = ngx_http_lua_rokfoss_error_line(cf, err);
+        ngx_conf_log_error(NGX_LOG_EMERG, cf, 0,
+                           "Lua 문법 검사에 실패했습니다 (%s): %s",
+                           tag, err);
+        cf->conf_file->line = saved_line;
+
+        lua_close(L);
+        return NGX_ERROR;
+    }
+
+    lua_close(L);
+    return NGX_OK;
+}
+
+
+ngx_int_t
+ngx_http_lua_rokfoss_test_file(ngx_conf_t *cf, const u_char *src,
+    size_t src_len)
+{
+    int          rc;
+    u_char      *script;
+    lua_State   *L;
+    const char  *err;
+
+    if (!ngx_test_config) {
+        return NGX_OK;
+    }
+
+    script = ngx_http_lua_rebase_path(cf->pool, (u_char *) src, src_len);
+    if (script == NULL) {
+        ngx_conf_log_error(NGX_LOG_EMERG, cf, 0,
+                           "Lua 파일 경로를 확인하지 못했습니다");
+        return NGX_ERROR;
+    }
+
+    L = luaL_newstate();
+    if (L == NULL) {
+        ngx_conf_log_error(NGX_LOG_EMERG, cf, 0,
+                           "Lua 파일 검사용 VM을 초기화하지 못했습니다");
+        return NGX_ERROR;
+    }
+
+    luaL_openlibs(L);
+
+    rc = ngx_http_lua_clfactory_loadfile(L, (char *) script);
+    if (rc != 0) {
+        err = lua_isstring(L, -1) ? lua_tostring(L, -1) : "unknown error";
+
+        ngx_conf_log_error(NGX_LOG_EMERG, cf, 0,
+                           "Lua 파일 검사에 실패했습니다 (\"%s\"): %s",
+                           script, err);
+        lua_close(L);
+        return NGX_ERROR;
+    }
+
+    lua_close(L);
+    return NGX_OK;
+}
